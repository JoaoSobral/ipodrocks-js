# The build stage runs `npm ci` itself, so a host tree — built for Electron's
# ABI on a different platform — must never be copied in over it.
node_modules
dist
out
ffmpeg-bin
release

# Test and docs output
test-results
playwright-report
.playwright
docs/.vitepress/dist
docs/.vitepress/cache

# Local state that would leak a developer's library into an image
*.db
*.db-journal
*.db-wal
*.log

.git
.gitignore
.DS_Store
.claude
